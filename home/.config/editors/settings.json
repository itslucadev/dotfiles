{
    "[css][graphql][html][markdown][scss][yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[javascript][javascriptreact][json][jsonc][typescript][typescriptreact]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true
    },
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        },
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },
    "cursor.composer.editorConversationDensity": "compact-all-grouped",
    "cursor.composer.shouldChimeAfterChatFinishes": true,
    "cursor.general.glassShowWarningNotifications": true,
    "cursor.terminal.usePreviewBox": true,
    "editor.fontFamily": "Hack Nerd Font Mono",
    "editor.fontSize": 14,
    "errorLens.messageMaxChars": 160,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "files.autoSave": "afterDelay",
    "git.enableSmartCommit": true,
    "python-envs.alwaysUseUv": true,
    "ruff.configurationPreference": "filesystemFirst",
    "terminal.integrated.fontFamily": "Hack Nerd Font Mono",
    // Todo Tree looks for the editor's bundled ripgrep under
    // `@vscode/ripgrep/bin/rg`, which VS Code no longer ships: it now unpacks
    // `@vscode/ripgrep-universal` into a per-architecture directory instead. The
    // Homebrew binary from the Brewfile is pointed at directly, because it stays
    // in place across editor updates and serves VS Code and Cursor alike.
    "todo-tree.ripgrep": "/opt/homebrew/bin/rg",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "window.autoDetectColorScheme": false,
    "workbench.preferredDarkColorTheme": "Rosé Pine Moon",
    "json.schemaDownload.trustedDomains": {
        "https://schemastore.azurewebsites.net/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://www.schemastore.org/": true,
        "https://json.schemastore.org/": true,
        "https://json-schema.org/": true,
        "https://developer.microsoft.com/json-schemas/": true,
        "https://biomejs.dev": true
    },
    "workbench.colorTheme": "Rosé Pine Moon",
    "git.autofetch": true,
    "redhat.telemetry.enabled": false,
    "totalTypeScript.hideAllTips": false,
    "totalTypeScript.hideBasicTips": false,
    "editor.accessibilitySupport": "off",
    "security.workspace.trust.untrustedFiles": "open"
}
