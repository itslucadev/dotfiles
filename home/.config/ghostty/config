theme = Rose Pine Moon
font-family = Hack Nerd Font
font-size = 14

background-opacity = 0.8
background-blur = 50

# Luft zum Fensterrand, sonst klebt der Prompt an der Kante.
# window-padding-y nimmt "oben,unten"; oben etwas mehr, damit die erste Zeile
# nicht direkt an der Titelleiste klebt.
window-padding-x = 12
window-padding-y = 10,8
# Restpixel gleichmaessig verteilen statt alles rechts/unten anzuhaengen.
window-padding-balance = true

mouse-hide-while-typing = true
macos-option-as-alt = right
confirm-close-surface = false

# On macOS the tab bar lives in the titlebar, so `hidden` opens tabs that cannot
# be seen. `tabs` keeps the minimal look by integrating the tab bar into a
# titlebar that matches the terminal background, and it shows a tab bar as soon
# as a second tab exists. `window-show-tab-bar` is not an option here: it is
# GTK-only and does nothing on macOS.
macos-titlebar-style = tabs

# Install Ghostty terminfo on SSH hosts when possible.
shell-integration-features = ssh-env,ssh-terminfo

# Ghostty has no setting for the "Last login" banner. It starts every surface
# through `/usr/bin/login`, the way Terminal.app does, and that banner is
# silenced by the managed `~/.hushlogin` instead.
