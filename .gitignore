.worktrees/

# macOS
.DS_Store

# Local mise overrides
mise.local.toml
mise.local.lock
mise.*.local.toml
mise.*.local.lock

# Resolved mise versions. Only mise can write this file, and every declared
# entry is a fuzzy version, so a committed copy drifts out of date without ever
# being the source of truth. Each machine keeps its own.
mise.lock

# Local shell configuration and history
*.local
# `*.local` is meant for override files, but it also matches the `home/.local`
# directory, which holds managed commands. The directory is re-included here so
# its contents stay trackable, and the pattern above still excludes an override
# file anywhere else.
!home/.local/
.zsh_history
.zsh_sessions/
home/.claude/settings.local.json

# Environment files and package-manager credentials
.env
.env.*
!.env.example
.npmrc
.yarnrc

# Application exports and authentication state
*.rayconfig
home/.config/gh/hosts.yml
home/.config/configstore/
home/.claude/.credentials.json
home/.codex/auth.json
home/.homebrew/trust.json

# Keys and certificates
*.key
*.pem
*.p12
*.pfx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
home/.ssh/allowed_signers
home/.ssh/authorized_keys
home/.ssh/known_hosts
home/.ssh/known_hosts.old

# Lavish review artifacts
.lavish/
